# =============================================================
# GenAI Backend - Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# =============================================================

# --- Application ---
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed origins, or * for any (development only)
CORS_ORIGIN=*

# --- Logging ---
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Pretty-print logs in development
LOG_PRETTY=true

# --- Swagger / OpenAPI docs (disable in production) ---
ENABLE_SWAGGER=true

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
DB_NAME=genai

# --- JWT Auth ---
# Generate dev secrets with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-generate-a-real-32-byte-hex-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-generate-a-different-32-byte-hex-secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_BCRYPT_ROUNDS=12

# --- AI Provider ---
# groq = LLaMA models via https://console.groq.com (requires GROQ_API_KEY)
# anthropic = https://api.anthropic.com (requires ANTHROPIC_API_KEY)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2500
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=4096

# --- Voice transcription (student voice answers) ---
TRANSCRIPTION_PROVIDER=groq
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# --- Embeddings (RAG) ---
EMBEDDING_PROVIDER=gemini
# Must match the numDimensions of the Atlas Vector Search index
EMBEDDING_DIMENSIONS=768
GEMINI_API_KEY=

# AI Evaluation Engine service. Run it beside the backend:
#   cd <engine-folder> && pip install -r requirements.txt && uvicorn app.api:app --port 8002
ASSESSMENT_ENGINE_ENABLED=true
ASSESSMENT_ENGINE_URL=http://localhost:8002

# --- Knowledge ingestion / retrieval ---
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=150
# auto = try Atlas $vectorSearch then fall back to in-process cosine scan
# atlas = Atlas only | fallback = in-process scan only (development)
VECTOR_SEARCH_MODE=auto
# Name of the Atlas Vector Search index on material_chunks.embedding
ATLAS_VECTOR_INDEX_NAME=material_chunks_vector

# --- Rate Limiting (global, per IP) ---
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
# Failed auth attempts (register/login/refresh) allowed per window per IP
AUTH_FAILED_ATTEMPTS_LIMIT=10

# Directory for original material files (relative to the project root or absolute)
# Already gitignored; originals are downloadable through an authenticated endpoint
UPLOADS_DIR=uploads