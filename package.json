{
  "name": "genai-backend",
  "version": "0.1.0",
  "description": "GenAI - AI Academic Learning Platform backend. Modular monolith built with Node.js, Express, and MongoDB.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "seed": "node src/seeders/seed.js",
    "seed:admin": "node src/seeders/seed-admin.js",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/api.integration.test.mjs tests/voice-schema.test.mjs tests/lerna.bridge.test.mjs",
    "test:grading": "node --test tests/grading.unit.test.mjs",
    "test:engine": "node --test tests/engine.live.test.mjs",
    "test:lerbra-live": "node --test tests/live-smoke.test.mjs",
    "test:watch": "nodemon --exec \"npm run test:grading\" --watch src --watch tests --ext js,mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "multer": "^2.3.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pptxgenjs": "^4.0.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "undici": "^8.10.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "mongodb-memory-server": "^9.5.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6"
  }
}
